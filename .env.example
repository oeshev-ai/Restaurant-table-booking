# Скопируйте в .env и заполните своими значениями:
#   copy .env.example .env
#
# Сгенерировать секреты (PowerShell / bash):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# ВАЖНО: не используйте secret / password / dev-only-change-me.
# Смена DB_PASSWORD после первого запуска требует пересоздания тома:
#   docker compose down -v

DB_HOST=localhost
DB_PORT=5432
DB_NAME=booking
DB_USER=postgres
DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET

# Порт веб-приложения на хосте
PORT=5000

# 1 — если сайт открывается только по HTTPS (за reverse proxy)
SESSION_COOKIE_SECURE=0
